# Proveedor del modelo: "openrouter" (por defecto, modelo común del curso) u "openai" (fallback).
PROVIDER=openrouter

MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Solo si PROVIDER=openai
OPENAI_MODEL_ID=gpt-4o-mini
OPENAI_API_KEY=

# Dónde corre el servidor FastMCP (api/mcp.py) en local.
MCP_URL=http://127.0.0.1:8001/

# Opcional
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mvp-datawarehouse-medallion
